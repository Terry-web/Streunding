# Kopieer naar /opt/streunding/.env.production op de VPS (buiten git, bevat
# geen geheimen zelf — de anon key is bedoeld om publiek te zijn — maar hoort
# toch niet in de repo, zelfde als .env.local nu).
#
# BELANGRIJK: dit zijn NEXT_PUBLIC_*-variabelen — die worden bij het bouwen
# (npm run build) in de client-bundel gebakken. Dit bestand moet dus al
# correct staan VOORDAT je build/deploy.sh draait, niet pas erna.

NEXT_PUBLIC_SITE_URL=https://streunding.nl

# Moet https zijn, niet de huidige http://192.168.1.117:8000 of
# http://mc.streunding.nl:8000 — anders gaan sessies/tokens tussen de VPS en
# je thuis-Supabase onversleuteld over het publieke internet. Zet eerst een
# reverse proxy + Let's Encrypt-certificaat vóór Kong thuis (zelfde aanpak
# als de Caddyfile hier, maar dan bij Supabase thuis), dan pas deze URL
# aanpassen.
NEXT_PUBLIC_SUPABASE_URL=https://mc.streunding.nl

NEXT_PUBLIC_SUPABASE_ANON_KEY=
